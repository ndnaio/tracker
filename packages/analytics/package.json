{
  "name": "@ndna/analytics",
  "version": "0.1.0",
  "description": "Privacy-first, cookieless analytics tracker for ndna analytics — ~1.5 KB, typed, with Vue and React bindings.",
  "license": "MIT",
  "author": {
    "name": "ndna.io",
    "url": "https://ndna.io"
  },
  "homepage": "https://analytics.ndna.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndnaio/tracker.git",
    "directory": "packages/analytics"
  },
  "bugs": "https://github.com/ndnaio/tracker/issues",
  "keywords": [
    "analytics",
    "privacy",
    "cookieless",
    "gdpr",
    "tracker",
    "vue",
    "react"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "vue": [
        "./dist/vue.d.ts"
      ],
      "react": [
        "./dist/react.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=17",
    "vue": ">=3.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "happy-dom": "^18.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.13"
  },
  "publishConfig": {
    "access": "public"
  }
}
